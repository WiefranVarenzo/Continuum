{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimum core window capability for the local Continuum report surface.",
  "windows": ["main"],
  "permissions": ["core:default", "core:window:allow-close", "core:window:allow-destroy", "core:window:allow-set-size", "core:window:allow-is-fullscreen", "core:window:allow-set-fullscreen", "dialog:allow-open", "clipboard-manager:allow-read-image", "clipboard-manager:allow-write-text"]
}
