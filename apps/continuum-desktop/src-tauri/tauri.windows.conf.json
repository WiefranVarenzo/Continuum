{
  "build": {
    "beforeBuildCommand": "node scripts/prepare-windows.mjs"
  },
  "bundle": {
    "useLocalToolsDir": true,
    "targets": "nsis",
    "resources": {
      "../../../target/release/continuum-mcp": null,
      "../../../packaging/gstreamer-1.0": null,
      "../../../packaging/windows/continuum-mcp.exe": "continuum-mcp.exe",
      "../../../packaging/windows/tools/": "tools/"
    },
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
